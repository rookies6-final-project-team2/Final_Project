# 복사해서 .env 로 사용 (.env 는 Git 에 올리지 않기)
# 이 파일에는 공개돼도 되는 값만 적음. 비밀번호·토큰·카메라 계정은 .env 에만

# 이미지를 올리는 Docker Hub 계정 이름 (공개 정보, 로그인 정보 아님)
DOCKERHUB_USER=ekrong01

# 이미지 버전 (CONVENTION.md "Docker 이미지 태그 규칙")
#   평소 개발: develop / 릴리스 검증: v0.1.0-rc.1 / 시연·배포: v0.1.0
APP_VERSION=develop

# 가상 카메라 (compose 내부 통신)
RTSP_URL=rtsp://mediamtx:8554/cam1
# 실제 IP 카메라로 교체 시 예시
# RTSP_URL=rtsp://계정:비밀번호@192.168.0.50:554/stream1

RTSP_LATENCY_MS=200
PRINT_EVERY=30
